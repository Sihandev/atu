# Supabase — Dashboard > Settings > API
# Both are public values that ship in the browser bundle. What keeps orders
# private is the Row Level Security policy in supabase/schema.sql, which lets
# anonymous visitors INSERT an order but never read one back.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
